{
  "name": "ssh",
  "args": [
    {
      "name": "destination",
      "description": "Host dari ~/.ssh/config dan known_hosts",
      "generators": [{ "template": ["uf:hosts"] }]
    }
  ],
  "options": [
    { "name": ["-i"], "args": [{ "name": "identity_file", "template": ["filepaths"] }] },
    { "name": ["-F"], "args": [{ "name": "configfile", "template": ["filepaths"] }] },
    { "name": ["-J"], "args": [{ "name": "destination", "template": ["uf:hosts"] }] }
  ]
}
